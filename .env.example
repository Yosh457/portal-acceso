# =============================================================================
# PORTAL DE ACCESO APS - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =============================================================================
# Copiar este archivo como .env y configurar los valores correspondientes.
#
# El archivo .env contiene información sensible y NO debe subirse a Git.
# El archivo .env.example sí debe mantenerse versionado.
# =============================================================================

# -----------------------------------------------------------------------------
# SEGURIDAD DE FLASK
# -----------------------------------------------------------------------------

# Clave secreta utilizada para proteger las sesiones y los tokens CSRF.
# Generar una clave aleatoria, larga y única para cada entorno.
SECRET_KEY="REEMPLAZAR_POR_UNA_CLAVE_SECRETA_SEGURA"

# -----------------------------------------------------------------------------
# CONEXIÓN A BASE DE DATOS MYSQL
# -----------------------------------------------------------------------------

# Dirección del servidor MySQL.
MYSQL_HOST=127.0.0.1

# Puerto de conexión MySQL.
MYSQL_PORT=3306

# Usuario de MySQL con permisos sobre la base de datos del sistema.
# Se recomienda utilizar un usuario exclusivo para esta aplicación.
MYSQL_USER="portal_acceso_user"

# Contraseña del usuario MySQL.
MYSQL_PASSWORD="REEMPLAZAR_POR_CONTRASENA_MYSQL"

# Nombre de la base de datos.
MYSQL_DB="portal_acceso_db"

# -----------------------------------------------------------------------------
# ENTORNO DE DESARROLLO
# -----------------------------------------------------------------------------

# 1 = Depuración habilitada.
# 0 = Depuración deshabilitada.
# En producción debe mantenerse en 0.
FLASK_DEBUG=0

# -----------------------------------------------------------------------------
# CORREO ELECTRÓNICO
# -----------------------------------------------------------------------------

# Cuenta utilizada para enviar correos de activación y recuperación.
EMAIL_USUARIO="correo@ejemplo.cl"

# Contraseña de aplicación o credencial SMTP correspondiente.
EMAIL_CONTRASENA="REEMPLAZAR_POR_CREDENCIAL_DE_CORREO"

# -----------------------------------------------------------------------------
# SERVIDOR WAITRESS
# -----------------------------------------------------------------------------

# Puerto reservado para ejecutar la aplicación mediante Waitress.
# Esta variable se utilizará cuando se configure el arranque con Waitress.
WAITRESS_PORT=8080

# -----------------------------------------------------------------------------
# URL PÚBLICA O BASE DEL SISTEMA
# -----------------------------------------------------------------------------

# Dirección base utilizada para generar enlaces de correos electrónicos.
#
# Desarrollo local:
# http://127.0.0.1:5000
#
# Producción:
# https://dominio-institucional.cl
#
# No agregar una barra final.
PORTAL_BASE_URL="http://127.0.0.1:5000"